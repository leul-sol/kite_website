# Server-only gateway URL. Never put tokens or internal service credentials here.
KITE_API_BASE_URL=http://localhost:8080
# Set the exact public origin when behind an HTTPS reverse proxy (no trailing slash).
# KITE_PORTAL_ORIGIN=https://partners.example.com
# Google sign-in: the OAuth web client id (public). Leave empty to hide "Continue with Google".
# The backend must list the same id in KITE_AUTH_GOOGLE_CLIENT_IDS.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
